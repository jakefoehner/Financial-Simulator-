{
  "name": "finance-simulator",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "bundle": "tauri build",
    "release": "bash scripts/release.sh",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src && cargo fmt --all",
    "lint": "tsc --noEmit && prettier --check src && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "check": "npm run lint && npm test && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
